
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#101321">
<title>EbubeCode | Learn to Code</title>
<style>
:root {
  --bg:#0d1020; --panel:#171b2d; --panel2:#20263b;
  --text:#f4f5ff; --muted:#a0a8c2; --purple:#9370ff;
  --green:#58e6ac; --border:#30364d;
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);
font-family:system-ui,-apple-system,sans-serif}
button,textarea{font:inherit}
button{cursor:pointer}
.app{display:flex;min-height:100vh}
aside{width:235px;padding:25px 16px;background:#111425;
border-right:1px solid var(--border);flex-shrink:0}
.brand{font-size:23px;font-weight:850;margin:4px 10px 34px}
.brand span{color:var(--purple)}
.label{font-size:11px;color:var(--muted);letter-spacing:2px;
margin:25px 12px 12px}
.nav{display:block;width:100%;text-align:left;border:0;
padding:13px 14px;margin:5px 0;border-radius:10px;
color:#c2c8df;background:transparent}
.nav.active,.nav:hover{background:#292441;color:white}
.nav.active{border-left:3px solid var(--purple)}
main{flex:1;min-width:0}
header{height:68px;border-bottom:1px solid var(--border);
display:flex;align-items:center;justify-content:space-between;
padding:0 28px;gap:12px}
header small{color:var(--muted)}
.wrap{max-width:1150px;margin:auto;padding:28px}
.hero{padding:35px;border:1px solid #38314f;border-radius:20px;
background:radial-gradient(ellipse at 90% 10%,#47316c 0,transparent 40%),
linear-gradient(120deg,#1d2038,#17172b);
display:flex;justify-content:space-between;gap:24px;align-items:center}
.eyebrow{font-size:11px;letter-spacing:2px;color:var(--green);
font-weight:800}
h1{font-size:clamp(32px,5vw,49px);line-height:1.1;
margin:14px 0}
h1 span{color:var(--purple)}
p{color:var(--muted);line-height:1.7}
.hero p{max-width:510px}
button.primary{background:var(--purple);color:white;border:0;
border-radius:10px;padding:12px 17px;font-weight:750}
button.secondary{background:var(--panel2);color:white;
border:1px solid var(--border);border-radius:9px;padding:10px 14px}
button:focus-visible,textarea:focus-visible{outline:2px solid var(--green)}
.code-art{font:16px/2 monospace;color:var(--green);
background:#0b0d18;border:1px solid #45405f;padding:24px;
border-radius:15px;min-width:210px}
.stats,.cards{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));
gap:14px;margin:22px 0}
.stat,.card,.panel{background:var(--panel);border:1px solid var(--border);
border-radius:14px;padding:20px}
.stat small{color:var(--muted);display:block;margin-bottom:12px}
.stat strong{font-size:27px}
h2{font-size:23px;margin:30px 0 8px}
h3{margin:7px 0;font-size:18px}
.cards{grid-template-columns:repeat(3,minmax(0,1fr))}
.card{display:flex;flex-direction:column;gap:9px}
.card .emoji{font-size:25px}
.card p{font-size:14px;flex:1;margin:0}
.tag{font-size:11px;color:var(--green);font-weight:750}
.progress{height:8px;background:#30354b;border-radius:8px;overflow:hidden}
.progress div{height:100%;width:0;background:var(--green);transition:width .3s}
.workspace{display:grid;grid-template-columns:1fr 1fr;gap:15px;margin-top:20px}
textarea{width:100%;min-height:255px;resize:vertical;
background:#0b0e19;color:#c9f6d9;border:1px solid var(--border);
border-radius:10px;padding:15px;font:14px/1.7 monospace}
.output{white-space:pre-wrap;overflow-wrap:anywhere;min-height:100px;
background:#0b0e19;padding:14px;border-radius:10px;color:var(--green);
font:13px/1.6 monospace}
.row{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.row button{margin-top:10px}
.option{display:block;text-align:left;width:100%;margin:9px 0;
padding:13px;background:var(--panel2);border:1px solid var(--border);
color:white;border-radius:9px}
.option:hover{border-color:var(--purple)}
.option:disabled{cursor:default;opacity:.9}
.correct{border-color:var(--green)!important}
.wrong{border-color:#ff727f!important}
.hidden{display:none!important}
footer{color:var(--muted);text-align:center;padding:30px 0;font-size:12px}
#toast{color:var(--green);margin-top:12px}
@media(max-width:900px){
aside{width:185px}.stats{grid-template-columns:repeat(2,minmax(0,1fr))}
.cards{grid-template-columns:repeat(2,minmax(0,1fr))}
.code-art{display:none}
}
@media(max-width:600px){
.app{display:block}aside{width:100%;padding:12px;
display:flex;align-items:center;gap:7px;overflow-x:auto}
.brand{font-size:17px;margin:0 12px 0 0;white-space:nowrap}
.label{display:none}.nav{width:auto;white-space:nowrap;
padding:10px;font-size:12px;margin:0}
header{padding:0 15px;height:55px}
.wrap{padding:16px}
.hero{padding:22px}.stats{gap:9px}.stat{padding:14px}
.cards{grid-template-columns:1fr}.workspace{grid-template-columns:1fr}
}
</style>
</head>
<body>
<div class="app">
<aside>
  <div class="brand">Ebube<span>Code</span></div>
  <div class="label">LEARNING SPACE</div>
  <button class="nav active" data-page="home">⌂ Home</button>
  <button class="nav" data-page="lessons">▤ Lessons</button>
  <button class="nav" data-page="editor">⌘ Code editor</button>
  <button class="nav" data-page="quiz">✳ Quiz</button>
  <button class="nav" data-page="challenges">⚡ Challenges</button>
</aside>
<main>
<header>
  <strong id="pageTitle">Dashboard</strong>
  <small>⚡ <b id="streak">0</b> learning streak</small>
</header>
<div class="wrap">

<section id="home">
  <div class="hero">
    <div>
      <div class="eyebrow">YOUR CODING JOURNEY STARTS HERE</div>
      <h1>Learn today.<br><span>Build tomorrow.</span></h1>
      <p>Master coding one lesson at a time. Practise JavaScript,
      test your knowledge and celebrate every new skill.</p>
      <button class="primary" data-open="lessons">Start learning →</button>
    </div>
    <div class="code-art">const future = "yours";<br>learn();<br>build(future);</div>
  </div>

  <div class="stats">
    <div class="stat"><small>Lessons completed</small>
      <strong id="lessonCount">0 / 6</strong></div>
    <div class="stat"><small>Code runs</small>
      <strong id="runCount">0</strong></div>
    <div class="stat"><small>Quiz points</small>
      <strong id="pointCount">0</strong></div>
    <div class="stat"><small>Challenges done</small>
      <strong id="challengeCount">0 / 3</strong></div>
  </div>

  <h2>Continue your journey</h2>
  <p>Choose a lesson and start building your skills.</p>
  <div class="cards" id="homeCards"></div>

  <div class="panel">
    <h3>Your overall progress</h3>
    <p id="progressText">0% complete</p>
    <div class="progress"><div id="progressBar"></div></div>
  </div>
</section>

<section id="lessons" class="hidden">
  <div class="eyebrow">LEARN AT YOUR OWN PACE</div>
  <h1>Code <span>lessons.</span></h1>
  <p>Start with the basics. Mark each lesson complete when
  you understand it.</p>
  <div class="cards" id="lessonCards"></div>
  <div class="panel hidden" id="lessonDetail">
    <div class="eyebrow" id="lessonTag"></div>
    <h2 id="lessonName"></h2>
    <p id="lessonDescription"></p>
    <h3>Example</h3>
    <textarea id="lessonExample" readonly></textarea>
    <div class="row">
      <button class="primary" id="completeLesson">Mark as completed ✓</button>
      <button class="secondary" data-open="editor">Practise in editor →</button>
    </div>
  </div>
</section>

<section id="editor" class="hidden">
  <div class="eyebrow">EXPERIMENT AND CREATE</div>
  <h1>Code <span>playground.</span></h1>
  <p>Write JavaScript, run your code and see the output.</p>
  <div class="workspace">
    <div class="panel">
      <h3>✎ Your JavaScript</h3>
      <textarea id="code" spellcheck="false">const name = "EbubeCode";
console.log("Hello, " + name + "!");
console.log(5 + 3);</textarea>
      <div class="row">
        <button class="primary" id="runCode">▶ Run code</button>
        <button class="secondary" id="resetCode">Reset example</button>
      </div>
      <p style="font-size:12px">For learning practice. Do not run code from strangers.</p>
    </div>
    <div class="panel">
      <h3>▣ Output</h3>
      <div class="output" id="output">Your results will appear here.</div>
      <div id="toast" role="status"></div>
    </div>
  </div>
</section>

<section id="quiz" class="hidden">
  <div class="eyebrow">TEST WHAT YOU KNOW</div>
  <h1>Quick <span>quiz.</span></h1>
  <p>Answer the questions and earn points.</p>
  <div class="panel">
    <small id="quizNumber">Question 1 of 5</small>
    <h2 id="question"></h2>
    <div id="answers"></div>
    <p id="quizFeedback" aria-live="polite"></p>
    <button class="primary hidden" id="nextQuestion">Next question →</button>
    <button class="secondary hidden" id="restartQuiz">Try again</button>
  </div>
</section>

<section id="challenges" class="hidden">
  <div class="eyebrow">PUT YOUR SKILLS TO WORK</div>
  <h1>Code <span>challenges.</span></h1>
  <p>Try these beginner tasks. Open the editor to write your solution.</p>
  <div class="cards" id="challengeCards"></div>
</section>

<footer>Keep learning. Keep building. <strong>EbubeCode</strong> © 2026</footer>
</div>
</main>
</div>

<script>
const lessons = [
 {title:"Your first JavaScript",level:"BEGINNER",icon:"🚀",
 description:"Learn what JavaScript is and display your first message.",
 detail:"JavaScript makes websites interactive. You can use console.log() to display information while practising.",
 code:'console.log("Hello, world!");'},
 {title:"Variables",level:"BEGINNER",icon:"📦",
 description:"Store information using let and const.",
 detail:"Use const for values you do not plan to reassign and let for values that can change.",
 code:'const name = "Ebube";\\nlet score = 10;\\nconsole.log(name, score);'},
 {title:"Numbers and maths",level:"BEGINNER",icon:"🔢",
 description:"Use JavaScript to add, subtract and multiply.",
 detail:"JavaScript supports +, -, *, and /. Parentheses can control the order of calculations.",
 code:'console.log(5 + 3);\\nconsole.log(10 - 4);\\nconsole.log(6 * 2);'},
 {title:"Strings",level:"BEGINNER",icon:"💬",
 description:"Work with text and join messages together.",
 detail:"Strings represent text. Put text inside quotes and use + to join strings.",
 code:'const first = "Ebube";\\nconsole.log("Hello, " + first);'},
 {title:"Conditions",level:"BEGINNER",icon:"🔀",
 description:"Make decisions with if and else.",
 detail:"An if statement runs code when a condition is true. Else handles the alternative.",
 code:'const score = 75;\\nif (score >= 50) {\\n console.log("You passed!");\\n} else {\\n console.log("Try again");\\n}'},
 {title:"Functions",level:"BEGINNER",icon:"⚙️",
 description:"Create reusable blocks of code.",
 detail:"A function groups instructions you can run whenever you call its name.",
 code:'function greet(name) {\\n return "Hello, " + name;\\n}\\nconsole.log(greet("Ebube"));'}
];

const questions = [
 {q:"Which keyword declares a variable that can be reassigned?",a:["const","let","fixed","define"],correct:1,why:"Use let when you need to reassign a variable."},
 {q:"Which command displays a message in the console?",a:["show()","printPage()","console.log()","message()"],correct:2,why:"console.log() prints values to the console."},
 {q:"What is 5 + 3 in JavaScript?",a:["53","8","2","15"],correct:1,why:"The + operator adds these two numbers."},
 {q:"Which symbol checks equality of value and type?",a:["=","==","===","!="],correct:2,why:"The strict equality operator is ===."},
 {q:"How do you define a function?",a:["function greet() {}","make greet() {}","def greet {}","new function greet"],correct:0,why:"The function keyword defines a JavaScript function."}
];

const challenges = [
 {title:"Add two numbers",icon:"➕",description:"Write a function named add that returns the sum of two numbers.",code:'function add(a, b) {\\n  return a + b;\\n}\\nconsole.log(add(4, 6));'},
 {title:"Check an age",icon:"🎯",description:"Create a variable age and use if/else to print Adult if age is at least 18.",code:'const age = 20;\\nif (age >= 18) {\\n console.log("Adult");\\n} else {\\n console.log("Not adult");\\n}'},
 {title:"Count to five",icon:"🔁",description:"Use a for loop to print numbers from 1 through 5.",code:'for (let i = 1; i <= 5; i++) {\\n console.log(i);\\n}'}
];

const defaults = {lessons:[],runs:0,points:0,doneChallenges:[]};
let state = {...defaults};
try {
 const saved = JSON.parse(localStorage.getItem("ebubecode-progress") || "{}");
 state = {...defaults,...saved};
} catch(e) {}

function save(){
 try {localStorage.setItem("ebubecode-progress",JSON.stringify(state));}
 catch(e){}
 renderStats();
}
function renderStats(){
 document.getElementById("lessonCount").textContent=state.lessons.length+" / "+lessons.length;
 document.getElementById("runCount").textContent=state.runs;
 document.getElementById("pointCount").textContent=state.points;
 document.getElementById("challengeCount").textContent=state.doneChallenges.length+" / "+challenges.length;
 const pct=Math.round(state.lessons.length/lessons.length*100);
 document.getElementById("progressText").textContent=pct+"% complete";
 document.getElementById("progressBar").style.width=pct+"%";
 document.getElementById("streak").textContent=state.lessons.length ? "1" : "0";
}
function card(item,index,type){
 const done=type==="lesson"?state.lessons.includes(index):state.doneChallenges.includes(index);
 return '<article class="card"><div class="emoji">'+item.icon+'</div><div class="tag">'+(item.level||"PRACTICE")+'</div><h3>'+item.title+'</h3><p>'+item.description+'</p><button class="secondary" data-'+type+'="'+index+'">'+(done?"✓ Completed":"Open lesson →")+'</button></article>';
}
function renderCards(){
 document.getElementById("homeCards").innerHTML=lessons.slice(0,3).map((x,i)=>card(x,i,"lesson")).join("");
 document.getElementById("lessonCards").innerHTML=lessons.map((x,i)=>card(x,i,"lesson")).join("");
 document.getElementById("challengeCards").innerHTML=challenges.map((x,i)=>card(x,i,"challenge")).join("");
}
function openPage(page){
 document.querySelectorAll("main section").forEach(s=>s.classList.add("hidden"));
 document.getElementById(page).classList.remove("hidden");
 document.querySelectorAll(".nav").forEach(b=>b.classList.toggle("active",b.dataset.page===page));
 document.getElementById("pageTitle").textContent=({home:"Dashboard",lessons:"Lessons",editor:"Code editor",quiz:"Quick quiz",challenges:"Challenges"})[page];
 window.scrollTo(0,0);
}
document.addEventListener("click",e=>{
 const nav=e.target.closest("[data-page]");
 const go=e.target.closest("[data-open]");
 if(nav) openPage(nav.dataset.page);
 if(go) openPage(go.dataset.open);
 const l=e.target.closest("[data-lesson]");
 if(l) showLesson(Number(l.dataset.lesson));
 const c=e.target.closest("[data-challenge]");
 if(c){
  document.getElementById("code").value=challenges[Number(c.dataset.challenge)].code.replace(/\\n/g,"\n");
  openPage("editor");
 }
});
function showLesson(i){
 const l=lessons[i];
 document.getElementById("lessonDetail").classList.remove("hidden");
 document.getElementById("lessonTag").textContent="LESSON "+(i+1)+" OF "+lessons.length;
 document.getElementById("lessonName").textContent=l.title;
 document.getElementById("lessonDescription").textContent=l.detail;
 document.getElementById("lessonExample").value=l.code.replace(/\\n/g,"\n");
 const btn=document.getElementById("completeLesson");
 btn.textContent=state.lessons.includes(i)?"✓ Completed":"Mark as completed ✓";
 btn.onclick=()=>{
  if(!state.lessons.includes(i)){state.lessons.push(i);save();renderCards();}
  btn.textContent="✓ Completed";
 };
 document.getElementById("lessonDetail").scrollIntoView({behavior:"smooth",block:"start"});
}
const sample='const name = "EbubeCode";\nconsole.log("Hello, " + name + "!");\nconsole.log(5 + 3);';
document.getElementById("resetCode").onclick=()=>document.getElementById("code").value=sample;
document.getElementById("runCode").onclick=()=>{
 const output=document.getElementById("output");
 output.textContent="";
 const logs=[];
 const fakeConsole={log:(...args)=>logs.push(args.map(x=>{
  if(typeof x==="object"&&x!==null){try{return JSON.stringify(x)}catch(e){return "[object]"}}
  return String(x);
 }).join(" "))};
 try{
  // Practice runner only. Use trusted code; this is not a secure sandbox.
  const code=document.getElementById("code").value;
  const fn=new Function("console",'"use strict";\n'+code);
  fn(fakeConsole);
  output.textContent=logs.join("\n")||"Code ran successfully. No output.";
  state.runs++;save();
 }catch(err){output.textContent=err.name+": "+err.message;}
};
let qi=0,answered=false,quizScore=0;
function showQuestion(){
 answered=false;
 document.getElementById("quizNumber").textContent="Question "+(qi+1)+" of "+questions.length;
 document.getElementById("question").textContent=questions[qi].q;
 document.getElementById("quizFeedback").textContent="";
 document.getElementById("nextQuestion").classList.add("hidden");
 document.getElementById("restartQuiz").classList.add("hidden");
 document.getElementById("answers").innerHTML=questions[qi].a.map((a,i)=>'<button class="option" data-answer="'+i+'">'+a+'</button>').join("");
}
document.getElementById("answers").addEventListener("click",e=>{
 const b=e.target.closest("[data-answer]");
 if(!b||answered)return;
 answered=true;
 const q=questions[qi],answer=Number(b.dataset.answer);
 document.querySelectorAll("[data-answer]").forEach((el,i)=>{
  el.disabled=true;
  if(i===q.correct)el.classList.add("correct");
  else if(i===answer)el.classList.add("wrong");
 });
 if(answer===q.correct){quizScore++;state.points+=10;save();}
 document.getElementById("quizFeedback").textContent=(answer===q.correct?"Correct! +10 points. ":"Not quite. ")+q.why;
 if(qi<questions.length-1)document.getElementById("nextQuestion").classList.remove("hidden");
 else{
  document.getElementById("quizFeedback").textContent+=" Quiz finished: "+quizScore+" / "+questions.length+" correct.";
  document.getElementById("restartQuiz").classList.remove("hidden");
 }
});
document.getElementById("nextQuestion").onclick=()=>{qi++;showQuestion();};
document.getElementById("restartQuiz").onclick=()=>{qi=0;quizScore=0;showQuestion();};
renderCards();renderStats();showQuestion();
</script>
</body>
</html>
